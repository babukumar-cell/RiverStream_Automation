# River Stream Application Environment
BASE_URL=https://riverstream-qa.azurewebsites.net/
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<admin password>
HEADLESS=true
# Number of parallel workers (default 1)
WORKERS=1

# Email Automation Settings
SENDER_EMAIL=<gmail address used to send test emails>
SENDER_APP_PASSWORD=<gmail app password>
INGESTION_EMAIL=riverstream.qa@riverstonetech.in
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
REPORT_RECIPIENTS=babukumar@riverstonetech.com

# Optional overrides for pre-existing QA data (see src/test-data/qa-data.ts)
# QA_DEFAULT_ORG=Riverstonetech
# QA_REFERENCE_ORG=MJ
# QA_RECON_PROJECT=Tech_Soluton
