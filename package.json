{
  "name": "riverstream-automation",
  "version": "1.0.0",
  "description": "Enterprise test automation framework for River Stream using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:auth": "playwright test tests/auth",
    "test:left-side": "playwright test tests/left-side",
    "test:clients": "playwright test tests/clients",
    "test:analytics": "playwright test tests/analytics",
    "test:upload": "playwright test tests/upload",
    "test:upload:allure": "npm run allure:clean && playwright test tests/upload && npm run allure:generate && npm run allure:open",
    "test:documents": "playwright test tests/documents",
    "test:recon": "playwright test tests/po-ack-recon",
    "test:recon:headed": "playwright test tests/po-ack-recon --headed",
    "test:review": "playwright test tests/review",
    "test:settings": "playwright test tests/settings",
    "test:email": "playwright test tests/email",
    "test:main": "npm run allure:clean && playwright test",
    "test:main:email": "node scripts/run-and-report.js",
    "typecheck": "tsc --noEmit -p .",
    "email:send": "ts-node --transpile-only src/scripts/send-sif-email.ts",
    "report": "ts-node --transpile-only src/reporters/generate-elegant-report.ts && node scripts/open-file.js playwright-report/index.html",
    "report:build": "ts-node --transpile-only src/reporters/generate-elegant-report.ts",
    "report:pdf": "ts-node --transpile-only src/utils/generate-pdf-report.ts",
    "report:email": "ts-node src/utils/send-test-report-email.ts",
    "report:email:preview": "ts-node src/utils/send-test-report-email.ts --dry-run",
    "allure:clean": "node -e \"const fs = require('fs'); if (fs.existsSync('allure-results')) fs.rmSync('allure-results', { recursive: true, force: true }); if (fs.existsSync('allure-report')) fs.rmSync('allure-report', { recursive: true, force: true });\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.49.1",
    "@types/imap-simple": "^4.2.9",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^2.15.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.36",
    "nodemailer": "^6.10.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
